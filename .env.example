# =================================================================
# CodePilot - Production Multi-Agent Software Engineering Assistant
# Environment Configuration
# =================================================================

# LLM Provider Configuration
# Options: 'gemini', 'openai', 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Key (Required when LLM_PROVIDER=gemini)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Key (Optional alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & Web Interface
HOST=127.0.0.1
PORT=8000
DEBUG=false

# RAG & ChromaDB Configuration
CHROMA_DIR=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Isolated Workspace & Security Sandbox
WORKSPACES_DIR=.workspaces
WORKSPACE_RETENTION_HOURS=24
COMMAND_TIMEOUT_SECONDS=45
MAX_RETRIES=3
